# Copy to .env.local (ignored by git) and fill in. Both values are public by design (the publishable
# key is protected by row level security), but they pick which Supabase project the app talks to.
# Production: set the same two variables in the hosting provider's build settings (Netlify).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
